/dev/block/platform/soc/11270000.ufshci/by-name/* 0660 root system
/dev/block/platform/soc/11240000.mmc/by-name/*    0660 root system
/dev/block/by-name/*                              0660 root system

# Graphics & Touch
/dev/graphics/*           0660 system graphics
/dev/input/*              0666 root   input
/dev/touch                0666 root   system
/dev/xiaomi-touch         0666 root   system
/dev/xiaomi-touch-knock   0664 root   system
/dev/xiaomi-thp           0664 root   system
