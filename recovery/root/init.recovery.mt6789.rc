on early-init
    # 1. Core clock, pin control, bus & power management modules
    insmod /lib/modules/pinctrl-mtk-v2.ko
    insmod /lib/modules/pinctrl-mt6789.ko
    insmod /lib/modules/clk-common.ko
    insmod /lib/modules/clk-mt6789.ko
    insmod /lib/modules/i2c-mt65xx.ko
    insmod /lib/modules/spi-mt65xx.ko
    insmod /lib/modules/mtk-pmic-wrap.ko
    insmod /lib/modules/mt6397.ko
    insmod /lib/modules/mt6358-regulator.ko
    insmod /lib/modules/mt6375.ko

    # 2. Display DRM & Panel drivers (Required to bypass splash logo freeze)
    insmod /lib/modules/drm_dma_helper.ko
    insmod /lib/modules/drm_display_helper.ko
    insmod /lib/modules/rt4831a_drv.ko
    insmod /lib/modules/mtk_panel_ext.ko
    insmod /lib/modules/panel-alpha-jdi-nt36672e-vdo-120hz-hfp.ko
    insmod /lib/modules/panel-n6-42-0d-0a-dsc-vdo.ko
    insmod /lib/modules/panel-n6-41-02-0b-dsc-vdo.ko
    insmod /lib/modules/panel-alpha-jdi-nt36672e-cphy-vdo.ko
    insmod /lib/modules/panel-truly-td4330-cmd.ko
    insmod /lib/modules/panel-tianma-r66451-cmd-120hz.ko
    insmod /lib/modules/panel-nt37801-cmd-fhd-10bit.ko
    insmod /lib/modules/panel-samsung-s68fc01-vdo-aod.ko
    insmod /lib/modules/mediatek_drm_v1.ko
    insmod /lib/modules/pwm-mtk-disp.ko
    insmod /lib/modules/leds-mtk.ko
    insmod /lib/modules/leds-mtk-disp.ko
    insmod /lib/modules/leds-mtk-pwm.ko

    # 3. UFS Storage Controller drivers (Required for /dev/block/.../11270000.ufshci)
    insmod /lib/modules/phy-generic.ko
    insmod /lib/modules/phy-mtk-ufs.ko
    insmod /lib/modules/rpmb.ko
    insmod /lib/modules/rpmb-mtk.ko
    insmod /lib/modules/ufs-mediatek-mod.ko
    insmod /lib/modules/ufs-mediatek-dbg.ko

    # 4. Touchscreen Prerequisites & Xiaomi Touch Core Framework
    insmod /lib/modules/hqsys_pcba.ko
    insmod /lib/modules/hqsysfs.ko
    insmod /lib/modules/miev.ko
    insmod /lib/modules/pd_dbg_info.ko
    insmod /lib/modules/tcpc_class.ko
    insmod /lib/modules/switch_class.ko
    insmod /lib/modules/xiaomi.ko

    # 5. Touchscreen IC Drivers (Goodix GT9916 & FocalTech FT3683G)
    insmod /lib/modules/gt9916.ko
    insmod /lib/modules/ft3683g.ko

    # 6. Touchscreen Boost Drivers
    insmod /lib/modules/mtk_ioctl_touch_boost.ko
    insmod /lib/modules/touch_boost.ko

    # 7. Hardware Keys, Vibrator, RTC & Battery Drivers
    insmod /lib/modules/mtk-pmic-keys.ko
    insmod /lib/modules/mtk-kpd.ko
    insmod /lib/modules/regulator-vibrator.ko
    insmod /lib/modules/haptic.ko
    insmod /lib/modules/rtc-mt6397.ko
    insmod /lib/modules/mtk_battery_manager.ko
    insmod /lib/modules/mt6358_battery.ko
    insmod /lib/modules/subpmic_charger.ko
    insmod /lib/modules/main_chg.ko

    # 8. Flashlight Drivers (LM3643 & MT6789 Flashlight)
    insmod /lib/modules/flashlight.ko
    insmod /lib/modules/lm3643.ko
    insmod /lib/modules/flashlights-mt6789.ko

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 0
    setprop sys.usb.ffs.ready 1
    setprop sys.usb.controller "musb-hdrc"
    setprop vendor.usb.controller "musb-hdrc"

on fs
    wait /dev/block/platform/soc/11270000.ufshci 10
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice
    symlink /dev/block/platform/soc/11270000.ufshci/by-name /dev/block/by-name
    mkdir /vendor 0755 root root
    mkdir /vendor/lib 0755 root root
    symlink /lib/modules /vendor/lib/modules
    symlink /lib/firmware /vendor/firmware

# Touchscreen, Backlight, Vibrator & Flashlight permissions
on boot
    # CPU & Scheduler Performance Optimization (Eliminates UI touch lag and boosts FPS)
    write /proc/sys/kernel/sched_util_clamp_min 128
    write /proc/sys/kernel/sched_energy_aware 0
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "performance"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "performance"
    write /sys/devices/system/cpu/cpuidle/current_governor teo

    # Backlight permissions
    chmod 0666 /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/brightness

    # Vibrator trigger & sysfs permissions
    chown system system /sys/class/leds/vibrator/trigger
    chown system system /sys/class/leds/awinic_vibrator/trigger
    write /sys/class/leds/vibrator/trigger "transient"
    write /sys/class/leds/awinic_vibrator/trigger "transient"
    chown system system /sys/class/leds/vibrator/activate
    chown system system /sys/class/leds/vibrator/brightness
    chown system system /sys/class/leds/vibrator/duration
    chown system system /sys/class/leds/vibrator/state
    chmod 0666 /sys/class/leds/vibrator/activate
    chmod 0666 /sys/class/leds/vibrator/duration
    chown system system /sys/class/leds/awinic_vibrator/brightness
    chmod 0666 /sys/class/leds/awinic_vibrator/brightness
    chown system system /sys/class/leds/awinic_vibrator/vibrator/activate
    chown system system /sys/class/leds/awinic_vibrator/vibrator/duration
    chown system system /sys/class/leds/awinic_vibrator/vibrator/state
    chmod 0666 /sys/class/leds/awinic_vibrator/vibrator/activate
    chmod 0666 /sys/class/leds/awinic_vibrator/vibrator/duration
    chmod 0666 /sys/class/leds/awinic_vibrator/vibrator/state

    # Flashlight permissions
    chmod 0666 /sys/devices/platform/flashlights_mt6789/mt6789_flash
    chown system system /sys/devices/platform/flashlights_mt6789/mt6789_flash

    chown system system /dev/xiaomi-touch
    chmod 0666 /dev/xiaomi-touch
    chown system system /dev/touch
    chmod 0666 /dev/touch
    chmod 0666 /dev/input/event0
    chmod 0666 /dev/input/event1
    chmod 0666 /dev/input/event2
    chmod 0666 /dev/input/event3
    chmod 0666 /dev/input/event4
    chmod 0666 /dev/input/event5
